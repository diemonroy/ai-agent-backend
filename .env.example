# ==============================================================================
# CONFIGURACIÓN DE ENTORNO Y SECRETOS (PLANTILLA SEGURA)
# Copia este archivo a `.env` y asigna tus credenciales.
# NOTA: `.env` está estrictamente ignorado por .gitignore y nunca debe comitearse.
# ==============================================================================

# Entorno: local | development | staging | production
ENVIRONMENT=local
PORT=8000
HOST=0.0.0.0

# ── PROVEEDOR DE LLM (GEMINI / GOOGLE CLOUD) ─────────────────────────────────
# Opción A: API Key directa de Google AI Studio / Gemini
GOOGLE_GEMINI_KEY=AIzaSy...Tu_Api_Key_Aqui

# Opción B: Integración con Google Cloud Secret Manager (Arquitectura Enterprise)
USE_GCP_SECRET_MANAGER=false
GCP_PROJECT=tu-proyecto-gcp
PROJECT_NUMBER=1234567890
SECRET_NAME_GEMINI=GOOGLE_GEMINI_KEY

# ── PROVEEDORES ALTERNATIVOS (OPCIONAL) ───────────────────────────────────────
OPENAI_API_KEY=sk-...Tu_OpenAI_Key_Opcional

# ── CONTACTO Y AGENDAMIENTO ──────────────────────────────────────────────────
RECRUITER_WHATSAPP_NUMBER=573108009394
RECRUITER_CONTACT_EMAIL=diego.97duran@gmail.com
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,https://diegomonroy.site
